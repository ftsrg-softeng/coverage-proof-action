# Exit-criterion (KIUGRÓ) thresholds, read by bin/coverage-proof.
#
# Course staff edit this file; students cannot override it from their own
# repositories, since the action reads it from here, not from the workflow.
# Every key is required. Coverage values are fractions in [0, 1].

# Class whose JaCoCo coverage is checked.
COVERAGE_CLASS=hu.bme.mit.spaceship.GT4500
MIN_INSTRUCTION_COVERAGE=0.8
MIN_BRANCH_COVERAGE=0.8

# Surefire suite whose tests are counted. A test counts only when it has an
# expected output and passes; the provided input-0/output-0 example counts too.
TEST_SUITE=hu.bme.mit.spaceship.SystemTests
MIN_ASSERTED_TESTS=4
